+/// Splits `1.2.3-pre.4+build` into its numbers, the prerelease number (null
+/// for a stable release) and the build number.
+({int major, int minor, int patch, int? pre, int build}) _parseVersion(
+  String version,
+) {
+  final parts = version.split('+');
+  final build = parts.length > 1 ? int.tryParse(parts[1]) ?? 0 : 0;
+  final core = parts[0].split('-');
+  final numbers = core[0].split('.');
+  int at(int index) =>
+      index < numbers.length ? int.tryParse(numbers[index]) ?? 0 : 0;
+  int? pre;
+  if (core.length > 1) {
+    final tail = core[1].split('.');
+    pre = tail.length > 1 ? int.tryParse(tail[1]) : int.tryParse(tail[0]);
+    pre ??= 0;
   }
-  final int build1 = version1.contains('+')
-      ? int.parse(version1.split('+')[1])
-      : 0;
-  final int build2 = version2.contains('+')
-      ? int.parse(version2.split('+')[1])
-      : 0;
-  return build1.compareTo(build2);
+  return (major: at(0), minor: at(1), patch: at(2), pre: pre, build: build);
+}
+
+/// Positive when [version1] is newer. A prerelease and the stable release with
+/// the same numbers count as equal: this fork builds both from the same
+/// upstream tag, so nudging a -pre user towards that stable would be noise.
+int compareVersions(String version1, String version2) {
+  final a = _parseVersion(version1);
+  final b = _parseVersion(version2);
+  if (a.major != b.major) return a.major.compareTo(b.major);
+  if (a.minor != b.minor) return a.minor.compareTo(b.minor);
+  if (a.patch != b.patch) return a.patch.compareTo(b.patch);
+  if (a.pre != null && b.pre != null) return a.pre!.compareTo(b.pre!);
+  if (a.pre != null || b.pre != null) return 0;
+  return a.build.compareTo(b.build);
 }
 
