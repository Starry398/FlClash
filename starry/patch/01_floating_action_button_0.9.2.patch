diff --git a/lib/views/dashboard/widgets/flclash_mark.dart b/lib/views/dashboard/widgets/flclash_mark.dart
new file mode 100644
index 0000000..842c311
--- /dev/null
+++ b/lib/views/dashboard/widgets/flclash_mark.dart
@@ -0,0 +1,108 @@
+import 'dart:math' as math;
+
+import 'package:material_ui/material_ui.dart';
+
+/// The FlClash logo, two slanted bars over a dot, drawn as a vector so it
+/// takes any colour and stays sharp at any size. [size] is its height. The
+/// bars take [color] and [secondary], the dot [dot], each [color] when null;
+/// [shadow] sets it off from a busy background, as on the launcher icon.
+class FlClashMark extends StatelessWidget {
+  const FlClashMark({
+    super.key,
+    required this.size,
+    required this.color,
+    this.secondary,
+    this.dot,
+    this.shadow = false,
+  });
+
+  final double size;
+  final Color color;
+  final Color? secondary;
+  final Color? dot;
+  final bool shadow;
+
+  @override
+  Widget build(BuildContext context) {
+    return SizedBox(
+      width: size * _MarkPainter._width / _MarkPainter._height,
+      height: size,
+      child: CustomPaint(
+        painter: _MarkPainter(color, secondary ?? color, dot ?? color, shadow),
+      ),
+    );
+  }
+}
+
+class _MarkPainter extends CustomPainter {
+  const _MarkPainter(this.bar, this.secondary, this.dot, this.shadow);
+
+  final Color bar;
+  final Color secondary;
+  final Color dot;
+  final bool shadow;
+
+  // The logo's own coordinates: the box around the three shapes, and each
+  // bar's centre line, which a stroke of [_radius] on both sides fills out.
+  static const _left = 51.65;
+  static const _top = 33.19;
+  static const _width = 129.53;
+  static const _height = 173.14;
+  static const _radius = 18.0;
+  static const _upper = (Offset(69.65, 105.19), Offset(163.18, 51.19));
+  static const _lower = (Offset(93.65, 146.76), Offset(140.42, 119.76));
+  static const _dotCenter = Offset(117.65, 188.33);
+
+  void _shapes(Canvas canvas, Paint upper, Paint lower, Paint dotPaint) {
+    for (final ((from, to), paint) in [(_upper, upper), (_lower, lower)]) {
+      final line = to - from;
+      canvas
+        ..save()
+        ..translate((from.dx + to.dx) / 2, (from.dy + to.dy) / 2)
+        ..rotate(math.atan2(line.dy, line.dx))
+        ..drawRRect(
+          RRect.fromRectAndRadius(
+            Rect.fromCenter(
+              center: Offset.zero,
+              width: line.distance + _radius * 2,
+              height: _radius * 2,
+            ),
+            const Radius.circular(_radius),
+          ),
+          paint,
+        )
+        ..restore();
+    }
+    canvas.drawCircle(_dotCenter, _radius, dotPaint);
+  }
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    Paint fill(Color color) => Paint()
+      ..color = color
+      ..isAntiAlias = true;
+    canvas
+      ..save()
+      ..scale(size.height / _height)
+      ..translate(-_left, -_top);
+    if (shadow) {
+      final cast = Paint()
+        ..color = const Color(0x6B1E1446)
+        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 7);
+      canvas
+        ..save()
+        ..translate(0, 9);
+      _shapes(canvas, cast, cast, cast);
+      canvas.restore();
+    }
+    _shapes(canvas, fill(bar), fill(secondary), fill(dot));
+    canvas.restore();
+  }
+
+  @override
+  bool shouldRepaint(_MarkPainter oldDelegate) =>
+      oldDelegate.bar != bar ||
+      oldDelegate.secondary != secondary ||
+      oldDelegate.dot != dot ||
+      oldDelegate.shadow != shadow;
+}
