+import 'package:fl_clash/ui/context.dart';
+import 'package:material_ui/material_ui.dart';
+
+/// Whether the page beside a corner button is being scrolled down, which is
+/// when the button leaves. [CommonScaffold] drives it.
+class FloatingActionScope extends InheritedNotifier<ValueNotifier<bool>> {
+  const FloatingActionScope({
+    super.key,
+    required ValueNotifier<bool> hidden,
+    required super.child,
+  }) : super(notifier: hidden);
+
+  static bool hiddenOf(BuildContext context) {
+    final scope = context
+        .dependOnInheritedWidgetOfExactType<FloatingActionScope>();
+    return scope?.notifier?.value ?? false;
+  }
+}
+
+/// Brings a corner button in and out. It rises and grows into place, with a
+/// small overshoot, and sinks and fades away. With [enter] it also waits a
+/// beat after the page opens before it first appears.
+class FloatingActionReveal extends StatefulWidget {
+  const FloatingActionReveal({
+    super.key,
+    required this.child,
+    this.visible = true,
+    this.enter = false,
+  });
+
+  final Widget child;
+  final bool visible;
+  final bool enter;
+
+  @override
+  State<FloatingActionReveal> createState() => _FloatingActionRevealState();
+}
+
+class _FloatingActionRevealState extends State<FloatingActionReveal> {
+  static const _enterDelay = Duration(milliseconds: 260);
+
+  late bool _entered = !widget.enter;
+
+  @override
+  void initState() {
+    super.initState();
+    if (!_entered) {
+      Future.delayed(_enterDelay, () {
+        if (mounted) {
+          setState(() => _entered = true);
+        }
+      });
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final show = _entered && widget.visible;
+    final duration = context.motionDuration(
+      Duration(milliseconds: show ? 420 : 220),
+    );
+    return IgnorePointer(
+      ignoring: !show,
+      child: AnimatedSlide(
+        offset: show ? Offset.zero : const Offset(0, 0.25),
+        duration: duration,
+        curve: show ? Curves.easeOutCubic : Curves.easeInCubic,
+        child: AnimatedScale(
+          scale: show ? 1 : 0.7,
+          duration: duration,
+          curve: show ? Curves.easeOutBack : Curves.easeInCubic,
+          child: AnimatedOpacity(
+            opacity: show ? 1 : 0,
+            duration: duration,
+            curve: show ? Curves.easeOut : Curves.easeIn,
+            child: widget.child,
+          ),
+        ),
+      ),
+    );
+  }
+}
