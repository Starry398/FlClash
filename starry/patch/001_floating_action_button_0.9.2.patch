+import 'dart:math' as math;
+
+import 'package:fl_clash/ui/context.dart';
+import 'package:flutter/foundation.dart' show clampDouble;
+import 'package:material_ui/material_ui.dart';
+
+/// How far a corner action bounces when it flips state.
+const double kFloatingBounce = 0.08;
+
+/// Fades a corner button in when its page opens, grows it to size, then lets a
+/// small wobble die out, so the button reads as arriving and settling rather
+/// than appearing frozen.
+class FloatingActionEntrance extends StatelessWidget {
+  const FloatingActionEntrance({super.key, required this.child});
+
+  final Widget child;
+
+  static const _duration = Duration(milliseconds: 620);
+
+  /// 0.94 to 1.00 over the first 45%, with no overshoot: a scale bounce on a
+  /// 144dp wide button reads as a jolt, which is what the wobble is for.
+  static double _scaleAt(double t) {
+    final progress = Curves.easeOutCubic.transform(
+      clampDouble(t / 0.45, 0, 1),
+    );
+    return 0.94 + 0.06 * progress;
+  }
+
+  /// A few decaying swings once the button is up. The tail falls away faster
+  /// than the head, which is what keeps it from looking like a metronome.
+  static double _wobbleAt(double t) {
+    if (t < 0.34) return 0;
+    final progress = (t - 0.34) / 0.66;
+    final decay = math.pow(1 - progress, 1.7).toDouble();
+    return math.sin(progress * math.pi * 5) * decay * 0.03;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return TweenAnimationBuilder<double>(
+      tween: Tween(begin: 0, end: 1),
+      duration: context.motionDuration(_duration),
+      child: child,
+      builder: (_, t, child) => Opacity(
+        opacity: clampDouble(t / 0.3, 0, 1),
+        child: Transform.rotate(
+          angle: _wobbleAt(t),
+          child: Transform.scale(scale: _scaleAt(t), child: child),
+        ),
+      ),
+    );
+  }
+}
+
+/// Bounces [child] when [trigger] flips, which is what a corner action does
+/// when it starts doing something. [risingOnly] keeps the bounce for the start
+/// of an action and leaves its end alone.
+class PressBounce extends StatefulWidget {
+  const PressBounce({
+    super.key,
+    required this.trigger,
+    required this.child,
+    this.enabled = true,
+    this.risingOnly = false,
+    this.bounce = kFloatingBounce,
+  });
+
+  final Object? trigger;
+  final Widget child;
+  final bool enabled;
+  final bool risingOnly;
+  final double bounce;
+
+  @override
+  State<PressBounce> createState() => _PressBounceState();
+}
+
+class _PressBounceState extends State<PressBounce>
+    with SingleTickerProviderStateMixin {
+  static const _duration = Duration(milliseconds: 340);
+
+  late final AnimationController _controller = AnimationController(
+    vsync: this,
+    duration: _duration,
+  );
+
+  @override
+  void didUpdateWidget(PressBounce oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (!widget.enabled || oldWidget.trigger == widget.trigger) return;
+    if (widget.risingOnly && widget.trigger != true) return;
+    _controller.forward(from: 0);
+  }
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AnimatedBuilder(
+      animation: _controller,
+      builder: (_, child) {
+        final bump = math.sin(math.pi * _controller.value) * widget.bounce;
+        if (bump == 0) return child!;
+        return Transform.scale(scale: 1 + bump, child: child);
+      },
+      child: widget.child,
+    );
+  }
+}
