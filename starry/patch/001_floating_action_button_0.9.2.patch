diff --git a/lib/views/dashboard/widgets/start_fab.dart b/lib/views/dashboard/widgets/start_fab.dart
new file mode 100644
index 0000000..d88cbae
--- /dev/null
+++ b/lib/views/dashboard/widgets/start_fab.dart
@@ -0,0 +1,139 @@
+import 'dart:ui' show FontFeature;
+
+import 'package:fl_clash/common/common.dart';
+import 'package:fl_clash/providers/providers.dart';
+import 'package:fl_clash/ui/floating_action.dart';
+import 'package:fl_clash/ui/icons/icons.dart';
+import 'package:fl_clash/ui/shape.dart';
+import 'package:fl_clash/widgets/widgets.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:material_ui/material_ui.dart';
+
+/// Starts and stops the tunnel from the corner of the page. Stopped, it is a
+/// plain play button; running, it widens to a pause button that carries the
+/// run time. The width, the icon and the time all move together when it
+/// starts or stops. It rises into place when the page opens.
+class StartFab extends ConsumerStatefulWidget {
+  const StartFab({super.key});
+
+  @override
+  ConsumerState<StartFab> createState() => _StartFabState();
+}
+
+class _StartFabState extends ConsumerState<StartFab> {
+  static const _size = 56.0;
+  static const _morphDuration = Duration(milliseconds: 360);
+  static const _widenDuration = Duration(milliseconds: 340);
+  static const _settleTime = Duration(milliseconds: 1200);
+
+  // The state the app opens with settles in as the core reports back. That
+  // is shown at once, so the entrance is the only motion in those moments.
+  final _openedAt = DateTime.now();
+
+  @override
+  Widget build(BuildContext context) {
+    final settled = DateTime.now().difference(_openedAt) > _settleTime;
+    final colorScheme = context.colorScheme;
+    final appLocalizations = context.appLocalizations;
+    final hasProfile = ref.watch(
+      profilesProvider.select((state) => state.isNotEmpty),
+    );
+    final isStart = ref.watch(isStartProvider);
+    final suspended = isStart && ref.watch(suspendProvider);
+    final runTime = isStart ? ref.watch(runTimeProvider) : null;
+    final ink = hasProfile
+        ? colorScheme.onPrimary
+        : colorScheme.onSurface.withValues(alpha: 0.38);
+    final labelStyle = (Theme.of(context).textTheme.labelLarge ?? const TextStyle())
+        .copyWith(
+          color: ink,
+          fontFeatures: const [FontFeature.tabularFigures()],
+        );
+    final icon = suspended
+        ? GlyphIcon(AppGlyphs.wifiOff, color: ink, fill: 1)
+        : TweenAnimationBuilder<double>(
+            tween: Tween(end: isStart ? 1 : 0),
+            duration: context.motionDuration(settled ? _morphDuration : Duration.zero),
+            curve: Curves.easeOutBack,
+            builder: (_, progress, _) =>
+                GlyphIcon(AppGlyphs.playPause(progress), color: ink, fill: 1),
+          );
+    final button = Material(
+      color: hasProfile
+          ? colorScheme.primary
+          : colorScheme.onSurface.withValues(alpha: 0.12),
+      shape: AppShape.md,
+      elevation: hasProfile ? 6 : 0,
+      shadowColor: colorScheme.shadow,
+      clipBehavior: Clip.antiAlias,
+      child: Tooltip(
+        message: suspended
+            ? appLocalizations.suspended
+            : isStart
+            ? appLocalizations.stop
+            : appLocalizations.start,
+        child: InkWell(
+          onTap: hasProfile
+              ? ref.read(commonActionProvider.notifier).toggleRunning
+              : null,
+          child: ConstrainedBox(
+            // The height is fixed: the widening time below fills whatever
+            // height it is given, and the corner slot gives it the whole page.
+            constraints: const BoxConstraints(
+              minWidth: _size,
+              minHeight: _size,
+              maxHeight: _size,
+            ),
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: 16),
+              child: Row(
+                mainAxisSize: MainAxisSize.min,
+                mainAxisAlignment: MainAxisAlignment.center,
+                children: [
+                  icon,
+                  // The time grows out of the icon as the button widens, and
+                  // folds back into it as the button narrows.
+                  AnimatedSwitcher(
+                    // While the opening state settles, each flip gets a fresh
+                    // switcher that simply shows it. A zero duration would
+                    // stay on the time that flip brought in, and fold it away
+                    // at once the first time the button is stopped.
+                    key: ValueKey(settled ? 'live' : 'opening-$isStart'),
+                    duration: context.motionDuration(_widenDuration),
+                    switchInCurve: Curves.easeOutCubic,
+                    switchOutCurve: Curves.easeInCubic,
+                    transitionBuilder: (child, animation) => SizeTransition(
+                      axis: Axis.horizontal,
+                      axisAlignment: -1,
+                      sizeFactor: animation,
+                      child: FadeTransition(opacity: animation, child: child),
+                    ),
+                    child: isStart
+                        ? Center(
+                            key: const ValueKey('time'),
+                            widthFactor: 1,
+                            child: Padding(
+                              padding: const EdgeInsetsDirectional.only(
+                                start: 8,
+                                end: 4,
+                              ),
+                              child: Text(
+                                getTimeText(runTime),
+                                maxLines: 1,
+                                softWrap: false,
+                                style: labelStyle,
+                              ),
+                            ),
+                          )
+                        : const SizedBox.shrink(key: ValueKey('none')),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+    return FloatingActionEntrance(child: button);
+  }
+}
