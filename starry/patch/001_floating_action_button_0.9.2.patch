+import 'package:fl_clash/ui/context.dart';
+import 'package:material_ui/material_ui.dart';
+
+/// Brings a corner button in when its page opens. It is there from the first
+/// frame, a little low and a little small, and settles into place.
+class FloatingActionEntrance extends StatelessWidget {
+  const FloatingActionEntrance({super.key, required this.child});
+
+  final Widget child;
+
+  static const _duration = Duration(milliseconds: 420);
+
+  @override
+  Widget build(BuildContext context) {
+    return TweenAnimationBuilder<double>(
+      tween: Tween(begin: 0, end: 1),
+      duration: context.motionDuration(_duration),
+      curve: Curves.easeOutCubic,
+      child: child,
+      builder: (_, t, child) => Transform.translate(
+        offset: Offset(0, 14 * (1 - t)),
+        child: Transform.scale(scale: 0.86 + 0.14 * t, child: child),
+      ),
+    );
+  }
+}
