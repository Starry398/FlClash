+import 'package:fl_clash/ui/context.dart';
+import 'package:material_ui/material_ui.dart';
+
+/// Fades a corner button in when its page opens. The motion itself belongs to
+/// the button: a corner control that is already running unrolls its width on
+/// the first frame, and that is the only movement worth showing here.
+class FloatingActionEntrance extends StatelessWidget {
+  const FloatingActionEntrance({super.key, required this.child});
+
+  final Widget child;
+
+  static const _duration = Duration(milliseconds: 160);
+
+  @override
+  Widget build(BuildContext context) {
+    return TweenAnimationBuilder<double>(
+      tween: Tween(begin: 0, end: 1),
+      duration: context.motionDuration(_duration),
+      curve: Curves.easeOut,
+      child: child,
+      builder: (_, t, child) => Opacity(opacity: t, child: child),
+    );
+  }
+}
